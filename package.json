{
  "name": "hcma2-teaching",
  "private": true,
  "type": "module",
  "description": "Static GitHub Pages frontend. This package.json exists only to run the Gate 1B.1 / 1B.2A / 1B.2B / 1B.2C / 1B.3-C1 / 1B.3-C2 / 1B.3-D1 / 1B.3-D2 / E2 / E6 test suites (test/gate1b1, test/gate1b2a, test/gate1b2b, test/gate1b2c, test/gate1b3c1, test/gate1b3c2, test/gate1b3d1, test/gate1b3d2, test/gate-e2, test/gate-e6) — it is not a build step for index.html, which stays a single deployable static file.",
  "scripts": {
    "test:pure": "node --test test/gate1b1/golden-legacy.test.mjs test/gate1b1/versioned-fixtures.test.mjs test/gate1b1/pii-canary.test.mjs",
    "test:emulator": "node test/gate1b1/run-emulator-tests.mjs",
    "test": "npm run test:pure && npm run test:emulator",
    "test:gate1b2a": "node test/gate1b2a/run-emulator-tests.mjs",
    "test:gate1b2b": "node test/gate1b2b/run-emulator-tests.mjs",
    "test:gate1b2c:pure": "node --test test/gate1b2c/semantics-resolution.test.mjs test/gate1b2c/view-model.test.mjs",
    "test:gate1b2c": "npm run test:gate1b2c:pure && node test/gate1b2c/run-emulator-tests.mjs",
    "test:gate1b3c1": "node test/gate1b3c1/run-emulator-tests.mjs",
    "test:gate1b3c2": "node test/gate1b3c2/run-emulator-tests.mjs",
    "test:gate1b3d1": "node test/gate1b3d1/run-emulator-tests.mjs",
    "test:gate1b3d2": "node test/gate1b3d2/run-emulator-tests.mjs",
    "test:gate-e2": "node test/gate-e2/run-emulator-tests.mjs",
    "test:gate-e6": "node test/gate-e6/run-emulator-tests.mjs",
    "test:gate2as:pure": "node --test test/gate2as/safe-group-file-link.test.mjs test/gate2as/source-guard.test.mjs",
    "test:gate2as": "npm run test:gate2as:pure && node test/gate2as/run-emulator-tests.mjs",
    "test:gate2a-auth-i1:pure": "node --test test/gate2a-auth-i1/additive-only-proof.test.mjs",
    "test:gate2a-auth-i1": "npm run test:gate2a-auth-i1:pure && node test/gate2a-auth-i1/run-emulator-tests.mjs",
    "test:gate2a-auth-i2:pure": "node --test test/gate2a-auth-i2/rules-hash-unchanged.test.mjs test/gate2a-auth-i2/source-guard.test.mjs test/gate2a-auth-i2/closed-activity-guard.test.mjs",
    "test:gate2a-auth-i2": "npm run test:gate2a-auth-i2:pure && node test/gate2a-auth-i2/run-emulator-tests.mjs",
    "test:gate2a-auth-i2-correction:pure": "node --test test/gate2a-auth-i2-correction/source-guard.test.mjs",
    "test:gate2a-auth-i2-correction": "npm run test:gate2a-auth-i2-correction:pure && node test/gate2a-auth-i2-correction/run-emulator-tests.mjs",
    "test:gate2a-auth-i2-correction-fix": "node --test test/gate2a-auth-i2-correction-fix/source-guard.test.mjs test/gate2a-auth-i2-correction-fix/generation-guard-pattern.test.mjs",
    "test:gate2a-auth-i3": "node test/gate2a-auth-i3/run-emulator-tests.mjs",
    "test:gate2a-auth-i3-ui-fix:pure": "node --test test/gate2a-auth-i3-ui-fix/source-guard.test.mjs",
    "test:gate2a-auth-i3-ui-fix": "npm run test:gate2a-auth-i3-ui-fix:pure && node test/gate2a-auth-i3-ui-fix/run-emulator-tests.mjs",
    "test:gate2b-rt-contract": "node --test test/gate2b-rt-contract/contract.test.mjs test/gate2b-rt-contract/renderer.test.mjs",
    "test:gate2b-rt-rules": "node test/gate2b-rt-rules/run-emulator-tests.mjs",
    "test:gate2b-rt-editor:pure": "node --test test/gate2b-rt-editor/serializer.test.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4"
  }
}

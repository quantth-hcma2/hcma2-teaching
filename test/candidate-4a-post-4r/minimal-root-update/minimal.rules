rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /activities/{id} {
      function notDeleted(activity) {
        return !('deletedAt' in activity) || activity.deletedAt == null;
      }
      function deletionKeysChanged() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'deletedAt', 'deletedBy', 'statusBeforeDelete'
        ]);
      }
      function legacyEdit() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title']);
      }
      allow update: if __EXPRESSION__;
    }
  }
}
